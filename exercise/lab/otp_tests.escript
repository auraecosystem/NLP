#!/usr/bin/env escript
%%! -pa .
main(_) ->
    io:format("== 1) counter ==~n"),
    {ok, C} = counter:start_link(0),
    counter:increment(C), counter:increment(C), counter:increment(C), counter:decrement(C),
    io:format("get -> ~p~n", [counter:get(C)]),
    C ! ping,
    counter:reset(C),
    io:format("tras reset -> ~p~n", [counter:get(C)]),
    io:format("llamada desconocida -> ~p~n", [gen_server:call(C, foo)]),
    counter:stop(C),
    io:format("~n== 2) stack ==~n"),
    {ok, S} = stack:start_link(),
    stack:push(S, a), stack:push(S, b), stack:push(S, c),
    io:format("size -> ~p~n", [stack:size(S)]),
    io:format("pop -> ~p~n", [stack:pop(S)]),
    io:format("pop -> ~p~n", [stack:pop(S)]),
    io:format("pop -> ~p~n", [stack:pop(S)]),
    io:format("pop -> ~p~n", [stack:pop(S)]),
    io:format("~n== 3) supervision ==~n"),
    unlink(S),
    {ok, Sup} = sup:start_link(),
    unlink(Sup),
    Old = whereis(counter),
    counter:increment(Old),
    io:format("estado antes del crash: ~p (pid ~p)~n", [counter:get(Old), Old]),
    exit(Old, kill),
    timer:sleep(200),
    New = whereis(counter),
    io:format("pid tras reinicio: ~p (distinto: ~p)~n", [New, New =/= Old]),
    io:format("estado tras reinicio: ~p~n", [counter:get(New)]),
    io:format("~n== 4) timeout de call ==~n"),
    {ok, P} = gen_server:start_link(counter, 0, []),
    unlink(P),
    sys:suspend(P),
    R = (catch gen_server:call(P, get, 300)),
    {'EXIT', {Reason, _}} = R, io:format("call a proceso suspendido -> exit con razon ~p~n", [Reason]).
